# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. NEVER commit .env.local (it is gitignored).
#
# Anything prefixed NEXT_PUBLIC_ is embedded into the JavaScript bundle and is
# readable by anyone who visits the site. Never put a private key behind that
# prefix. Do not paste real values into this example file.
# ---------------------------------------------------------------------------

# Canonical public URL of the site, no trailing slash.
NEXT_PUBLIC_SITE_URL=https://musadaq.live

# EmailJS - powers the contact form.
# These are public by design, so lock the account down in the EmailJS dashboard:
# Account > Security > enable "Allowed Domains" and list only your own domains.
# Without that, anyone can send mail through your quota using these IDs.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_CONTACT_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Optional analytics. Leave BOTH blank to ship zero third-party scripts.
# Only set these to a host you personally control - whatever origin you put here
# is granted permission to run arbitrary JavaScript for every visitor, and is
# automatically added to the Content-Security-Policy in next.config.js.
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=
